{
  "routes": [
    {
      "src": "/(lab|rescue|admin)(/.*)?",
      "headers": {
        "WWW-Authenticate": "Basic realm=\"SlushIQ Test\""
      },
      "status": 401,
      "dest": "/lab/index.html"
    },
    {
      "src": "/(.+\\.json)$",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
